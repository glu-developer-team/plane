# =============================================================================
# plane.env — runtime env cho docker compose (generated format)
# Khuyến nghị: generate từ operator.env thay vì sửa trực tiếp:
#   cp deploy/operator.env.example /opt/plane/operator.env
#   vim /opt/plane/operator.env
#   OPERATOR_ENV=/opt/plane/operator.env PLANE_ENV=/opt/plane/plane.env ./deploy/bin/generate-plane-env.sh
# =============================================================================

APP_DOMAIN=plane.bita.tokyo
DOCKERHUB_USER=plane-local
APP_RELEASE=develop

USE_BUNDLED_DB=true
USE_BUNDLED_REDIS=true
USE_BUNDLED_MINIO=true

USE_NGINX_PROXY=true
NGINX_CONF_PATH=/etc/nginx/conf.d/plane.conf
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PLANE_UPSTREAM_HOST=127.0.0.1
PLANE_UPSTREAM_PORT=8080
NGINX_SSL_ENABLED=true
SSL_CERT_PATH=/etc/letsencrypt/live/plane.bita.tokyo/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/plane.bita.tokyo/privkey.pem
CERT_EMAIL=duy_kieu@bita.jp

WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

WEB_URL=https://plane.bita.tokyo
DEBUG=0
CORS_ALLOWED_ORIGINS=https://plane.bita.tokyo
API_BASE_URL=http://api:8000

PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://plane:CHANGE_ME_STRONG_PASSWORD@plane-db:5432/plane

REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:CHANGE_ME_RABBITMQ_PASSWORD@plane-mq:5672/plane

CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_ACME_DNS=

SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=CHANGE_ME_SECRET_KEY
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

GUNICORN_WORKERS=1
MINIO_ENDPOINT_SSL=0
API_KEY_RATE_LIMIT=6000/minute

WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
EMAIL_FROM="Plane <your@gmail.com>"
SKIP_ENV_VAR=0
