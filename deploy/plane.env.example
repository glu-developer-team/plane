# =============================================================================
# Plane CE — Runtime env (self-hosted deploy)
# Copy to /opt/plane/plane.env on the server (NEVER commit secrets to git):
#   sudo mkdir -p /opt/plane
#   sudo cp deploy/plane.env.example /opt/plane/plane.env
#   sudo vim /opt/plane/plane.env
# =============================================================================

# Image tag — deploy.sh sets APP_RELEASE from git SHA automatically
DOCKERHUB_USER=plane-local
APP_RELEASE=develop

# Domain
APP_DOMAIN=plane.example.com
WEB_URL=https://plane.example.com
CORS_ALLOWED_ORIGINS=https://plane.example.com

# plane-proxy binds localhost; nginx terminates SSL and proxies here
PLANE_UPSTREAM_HOST=127.0.0.1
PLANE_UPSTREAM_PORT=8080

# Nginx (generate config: ./deploy/scripts/generate-nginx.sh)
NGINX_SSL_ENABLED=true
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
SSL_CERT_PATH=/etc/letsencrypt/live/plane.example.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/plane.example.com/privkey.pem

# PostgreSQL
POSTGRES_USER=plane
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=plane
POSTGRES_PORT=5432
DATABASE_URL=postgresql://plane:CHANGE_ME_STRONG_PASSWORD@plane-db:5432/plane

# Redis
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# RabbitMQ
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:CHANGE_ME_RABBITMQ_PASSWORD@plane-mq:5672/plane

# MinIO / S3
USE_MINIO=1
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=CHANGE_ME_SECRET_KEY
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
AWS_REGION=
MINIO_ENDPOINT_SSL=0

# Security — generate with: openssl rand -hex 32
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

# SMTP (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
SKIP_ENV_VAR=0

# Misc
DEBUG=0
GUNICORN_WORKERS=1
FILE_SIZE_LIMIT=5242880
API_KEY_RATE_LIMIT=6000/minute
